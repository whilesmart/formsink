PORT=3001

# Admin login password (required for production)
ADMIN_PASSWORD=change-this-password

# API key for external API access (optional - leave empty to disable external API)
API_KEY=

# CORS - comma-separated list of allowed origins (leave empty for *)
ALLOWED_ORIGINS=

# SMTP Configuration (optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TURNSTILE_REQUIRED_FORMS=contact,request-demo
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
TURNSTILE_HOSTNAMES=credflare.net,www.credflare.net
NOTIFICATION_COPY_TO=folks@whilesmart.com
